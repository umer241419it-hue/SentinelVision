{
  "name": "sentinelvision-ui",
  "productName": "SentinelVision",
  "private": true,
  "version": "1.0.0",
  "description": "SentinelVision — AI Security Command Center (React + Electron desktop UI)",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "bridge:dev": "npm --prefix ../bridge start",
    "electron:dev": "concurrently -k \"npm:bridge:dev\" \"vite\" \"wait-on tcp:127.0.0.1:3000 tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "electron:start": "npm run build && electron .",
    "electron:dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.sentinelvision.commandcenter",
    "productName": "SentinelVision",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "release"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
